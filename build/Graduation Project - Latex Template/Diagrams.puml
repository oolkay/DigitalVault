' PlantUML diagrams for the graduation project report.
' Copy one @startuml ... @enduml block into PlantText at a time.
' Suggested export format: SVG for clean text, PNG if LaTeX image inclusion is easier.
'
' These diagrams intentionally use conservative PlantUML syntax for PlantText compatibility.

@startuml
title System Architecture

skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial

package "Biometric Hardware Layer" {
  rectangle "AS608 Fingerprint Sensor" as AS608
  rectangle "STM32 Blue Pill Firmware Controller" as STM32
  rectangle "PL2303 USB-UART Bridge" as PL2303
}

package "Host Application Layer" {
  rectangle "Qt/QML GUI" as GUI
  rectangle "VaultController" as Controller
  rectangle "SerialBridge" as Serial
  rectangle "vault_manager" as Manager
}

package "Encrypted Storage Layer" {
  rectangle "cryptsetup" as Cryptsetup
  rectangle "LUKS2 dm-crypt Encrypted Mapper" as LUKS
  rectangle "ext4 Vault Filesystem" as FS
  rectangle "Physical Device or Virtual Container" as Device
}

AS608 --> STM32 : fingerprint match result
STM32 --> PL2303 : UART packets
PL2303 --> Serial : USB serial
GUI --> Controller : user actions
Controller --> Serial : enroll, verify, key request
Serial --> PL2303 : firmware commands
Controller --> Manager : setup, unlock, lock
Manager --> Cryptsetup : key through stdin
Cryptsetup --> LUKS : open or format mapper
LUKS --> FS : decrypted block device
Device --> LUKS : encrypted storage

note right of Controller
Tracks vault state, active workflow,
security logs, and recovery paths.
end note

note bottom of Manager
Performs privileged storage operations:
format, open, mount, unmount, close,
force-lock, and cleanup.
end note
@enduml


@startuml
title Hardware Connection Diagram

skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial

rectangle "AS608 Fingerprint Sensor" as AS608
rectangle "STM32 Blue Pill Firmware Controller" as STM32
rectangle "PL2303 USB-UART Bridge" as PL2303
rectangle "Host Computer Linux GUI Application" as Host

AS608 --> STM32 : UART TX RX, VCC, GND
STM32 --> PL2303 : UART TX RX, GND
