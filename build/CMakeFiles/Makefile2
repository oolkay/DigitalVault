	$(CMAKE_COMMAND) -E cmake_progress_start /home/omer/DigitalVault/build/CMakeFiles 28
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 gui/CMakeFiles/DigitalVaultGUI_autogen.dir/all
	$(CMAKE_COMMAND) -E cmake_progress_start /home/omer/DigitalVault/build/CMakeFiles 0
.PHONY : gui/CMakeFiles/DigitalVaultGUI_autogen.dir/rule

# Convenience name for target.
DigitalVaultGUI_autogen: gui/CMakeFiles/DigitalVaultGUI_autogen.dir/rule
